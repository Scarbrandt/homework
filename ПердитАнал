   "source": [
    "# 1. Построение тренда и остатков, анализ быстрых и медленных движений"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
     "height": 707
    },
    "id": "ovDVoywKVHj8",
    "outputId": "c4e97296-942a-4d6d-c411-51f238baaac2"
   },
   "outputs": [
    {
     "data": {
      "image/png": "\n",
      "text/plain": [
       "<Figure size 1400x700 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "from statsmodels.tsa.seasonal import seasonal_decompose\n",
    "\n",
    "# Декомпозиция временного ряда\n",
    "decomposition = seasonal_decompose(df['price_close'], model='multiplicative', period=12) #используем мультипликативную модель\n",
    "trend = decomposition.trend  # Медленные движения\n",
    "residual = decomposition.resid  # Быстрые движения\n",
    "\n",
    "plt.figure(figsize=(14, 7))\n",
    "plt.subplot(3, 1, 1)\n",
    "plt.plot(df.index, df['price_close'], label='Исходные данные')\n",
    "plt.legend()\n",
    "\n",
    "plt.subplot(3, 1, 2)\n",
    "plt.plot(df.index, trend, label='Тренд (медленные движения)', color='orange')\n",
    "plt.legend()\n",
    "\n",
    "plt.subplot(3, 1, 3)\n",
    "plt.plot(df.index, residual, label='Остатки (быстрые движения)', color='green')\n",
    "plt.legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
