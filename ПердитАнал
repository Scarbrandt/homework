   ],
   "source": [
    "from scipy.signal import periodogram\n",
    "import numpy as np\n",
    "\n",
    "# Спектральный анализ\n",
    "frequencies, power = periodogram(df['price_close'])\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "plt.plot(frequencies, power)\n",
    "plt.xlabel('Частота')\n",
    "plt.ylabel('Мощность')\n",
    "plt.title('Спектральный анализ временного ряда')\n",
    "plt.grid(True)\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
